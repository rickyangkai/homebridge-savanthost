{
  "name": "homebridge-savanthost",
  "displayName": "Homebridge SavantHost",
  "version": "1.2.4",
  "description": "Savant主机场景控制插件",
  "license": "MIT",
  "keywords": [
    "homebridge-plugin",
    "savant",
    "scene",
    "SavantHost",
    "control",
